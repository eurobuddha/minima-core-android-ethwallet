<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The same-address key is derived from the local Minima node over broadcast-Intent IPC. -->
    <queries>
        <package android:name="org.minimarex.minimacore" />
    </queries>

    <!-- Ethereum JSON-RPC for balances + broadcasting transactions. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Scan a recipient address QR. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- allowBackup=false: this app custodies an Ethereum private key, and the Tink keysets that
         protect it are sealed by a device-bound Keystore key that is never backed up — a restored
         copy is undecryptable and crash-loops the app. See backup_rules.xml. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.EthWallet"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
